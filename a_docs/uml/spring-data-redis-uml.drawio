            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="JedisConnectionFactory&lt;br&gt;【传统派】" 作用="Jedis 客户端的实例是线程不安全的。&#xa;&#xa;高并发痛点： 因此，JedisConnectionFactory 每次调用 getConnection() 时，必须从底层的对象池（如 Apache Commons Pool2）中借出一个独占的 Jedis 实例。如果 C 端流量激增，超过了连接池的 max-active，后续的请求就会阻塞甚至报错（获取连接超时）。它的并发上限直接受限于连接池的大小，在海量并发下，维护庞大连接池带来的上下文切换成本非常高。" id="Rnn9wGYFX2iCv91cSKAG-453">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="90" width="235.5" x="1143.26" y="4626" as="geometry">
              <mxRectangle height="229" width="371" x="533" y="4140" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-454" parent="Rnn9wGYFX2iCv91cSKAG-453" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="-pool: Pool&lt;Jedis&gt;" vertex="1">
          <mxGeometry height="35" width="371" y="46" as="geometry" />
