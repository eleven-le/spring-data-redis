        <object label="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 151, 48); font-size: 18px;&quot;&gt;&lt;span style=&quot;color: rgb(55, 53, 47);&quot;&gt;BeanDefinition&lt;/span&gt;&lt;font style=&quot;&quot;&gt;体系&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;" 总结="&#xa;💡 核心总结：你的日常开发与它们的映射&#xa;&#xa;作为写后端业务的，你几乎不直接 new 这些类，但你的代码处处都在创造它们：&#xa;&#xa;你写了一个 @Service，Spring 启动扫描时 -&gt; 帮你默默生成了一个 ScannedGenericBeanDefinition。&#xa;&#xa;你在 @Configuration 类里写了一个 @Bean 方法 -&gt; Spring 解析时帮你生成了 ConfigurationClassBeanDefinition。&#xa;&#xa;Spring 准备实例化你的 Service 时 -&gt; 把前面的 Definition 转换为 RootBeanDefinition（合并属性）。&#xa;&#xa;你的类里用了 @Value 或 @Autowired -&gt; Spring 通过解析这些图纸上的依赖信息，去容器里找别人，最终通过反射塞到你的实例中。&#xa;&#xa;这个体系之所以要这么细致地拆分，本质上是为了在保持向后兼容（XML 支持）的同时，优雅地拥抱注解时代，并在解析速度和扩展性之间取得完美的架构平衡。" id="Rnn9wGYFX2iCv91cSKAG-214">
          <mxCell parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;strokeWidth=3;fontSize=13;" vertex="1">
            <mxGeometry height="65" width="208" x="1629" y="905.5" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-215" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;strokeWidth=2;fillColor=#eeeeee;strokeColor=none;fontColor=#FFA530;rounded=1;shadow=0;glass=0;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;arcSize=12;fontFamily=Helvetica;fontSize=15;fontStyle=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="156" width="897" x="771.5" y="2212" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-216" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;strokeWidth=2;fillColor=#eeeeee;strokeColor=none;fontColor=#FFA530;rounded=1;shadow=0;glass=0;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;arcSize=12;fontFamily=Helvetica;fontSize=15;fontStyle=1;labelBackgroundColor=none;" value="" vertex="1">
