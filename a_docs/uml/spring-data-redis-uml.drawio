        <object label="&lt;span style=&quot;text-wrap-mode: nowrap; color: rgb(51, 51, 51); font-size: 12px;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br style=&quot;text-wrap-mode: nowrap; padding: 0px; margin: 0px; color: rgb(51, 51, 51); font-size: 12px;&quot;&gt;ReactiveRedisConnectionFactory&lt;br&gt;【响应式连接工厂】&lt;div&gt;&lt;br style=&quot;color: rgb(55, 53, 47);&quot;&gt;&lt;/div&gt;" 作用="在 Spring 5 引入 Reactor 响应式编程后新增的接口。它专门用于获取返回 Mono 或 Flux 的非阻塞连接。" 设计="注意看图，LettuceConnectionFactory 实现了它，而 JedisConnectionFactory 没有实现它。这是因为 Jedis 底层是基于传统阻塞 I/O 的，天生不支持响应式；而 Lettuce 基于 Netty，天生是异步非阻塞的。" id="Rnn9wGYFX2iCv91cSKAG-381">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="86" width="236" x="1690" y="4167.5" as="geometry">
              <mxRectangle height="120" width="500" x="1520" y="3990" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-382" parent="Rnn9wGYFX2iCv91cSKAG-381" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="500" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-383" parent="Rnn9wGYFX2iCv91cSKAG-381" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getReactiveConnection() : ReactiveRedisConnection" vertex="1">
          <mxGeometry height="47" width="500" y="73" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-414" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="Rnn9wGYFX2iCv91cSKAG-366" style="curved=1;startArrow=block;startSize=16;startFill=0;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;rounded=0;exitDx=0;exitDy=0;" target="Rnn9wGYFX2iCv91cSKAG-375" value="extends">
