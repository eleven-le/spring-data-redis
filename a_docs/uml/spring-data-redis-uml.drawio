        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;BeanMetadataElement&lt;br&gt;【源信息追踪器】&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" 作用="只有一个核心方法 Object getSource()，用于返回该配置元数据的来源。" 设计意图="为了可追溯性和报错排查。当一个 Bean 加载失败或发生冲突时，Spring 需要准确告诉你这个 Bean 是从哪里来的（是 applicationContext.xml 的第 20 行，还是某个 @Service 注解的类）。它将溯源能力独立解耦。" id="Rnn9wGYFX2iCv91cSKAG-161">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=60;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="91" width="182" x="1359.5" y="925" as="geometry">
              <mxRectangle height="139" width="384" x="-559" y="4368" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-162" parent="Rnn9wGYFX2iCv91cSKAG-161" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="384" y="60" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-163" parent="Rnn9wGYFX2iCv91cSKAG-161" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getSource() : Object" vertex="1">
          <mxGeometry height="71" width="384" y="68" as="geometry" />
        </mxCell>
        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;AttributeAccessor&lt;/font&gt;&lt;br&gt;【扩展属性贴纸】&lt;div&gt;&lt;br&gt;&lt;/div&gt;" 作用="定义了对任意属性（Attribute）的增删改查操作（类似 Map&lt;String, Object&gt;）。" 设计意图="遵循单一职责原则。在 Bean 的解析和实例化过程中，Spring 内部或第三方框架（如 MyBatis、Dubbo）经常需要给这个 Bean 临时打上一些“标记”或“附加数据”，但又不想修改原有的核心结构。这个接口赋予了类动态扩展元数据的能力。" 能力流转="向下传递了“属性管理”的契约。" id="Rnn9wGYFX2iCv91cSKAG-164">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=62;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="91" width="195" x="880.5" y="915.5" as="geometry">
              <mxRectangle height="190" width="450" x="-1027" y="4368" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-165" parent="Rnn9wGYFX2iCv91cSKAG-164" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="450" y="62" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-166" parent="Rnn9wGYFX2iCv91cSKAG-164" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+setAttribute(String, Object) : void" vertex="1">
          <mxGeometry height="60" width="450" y="70" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-167" parent="Rnn9wGYFX2iCv91cSKAG-164" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getAttribute(String) : Object" vertex="1">
          <mxGeometry height="60" width="450" y="130" as="geometry" />
        </mxCell>
        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;BeanDefinition&lt;/font&gt;&lt;br&gt;【核心图纸契约】" 作用="定义了描述一个 Spring Bean 应该具备的所有核心属性的 Get/Set 规范，例如：类名（BeanClass）、作用域（Scope，如单例/多例）、是否懒加载（Lazy-init）、依赖关系（DependsOn）等。" 设计意图="遵循依赖倒置原则。Spring BeanFactory 在按图纸实例化对象时，只依赖 BeanDefinition 这个抽象接口，而绝不依赖具体的 XML 解析器或注解扫描器。它同时继承了基石层的“扩展属性”和“溯源”能力，成为了一个完整的图纸规范。" id="Rnn9wGYFX2iCv91cSKAG-168">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=60;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="86" width="253" x="1317.5" y="1166.5" as="geometry">
              <mxRectangle height="261" width="681" x="-981" y="4711" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-169" parent="Rnn9wGYFX2iCv91cSKAG-168" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+String SCOPE_SINGLETON" vertex="1">
          <mxGeometry height="47" width="681" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-170" parent="Rnn9wGYFX2iCv91cSKAG-168" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="681" y="112" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-171" parent="Rnn9wGYFX2iCv91cSKAG-168" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+setBeanClassName()" vertex="1">
          <mxGeometry height="47" width="681" y="120" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-172" parent="Rnn9wGYFX2iCv91cSKAG-168" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+setLazyInit()" vertex="1">
          <mxGeometry height="47" width="681" y="167" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-173" parent="Rnn9wGYFX2iCv91cSKAG-168" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getPropertyValues()" vertex="1">
          <mxGeometry height="47" width="681" y="214" as="geometry" />
        </mxCell>
        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;AnnotatedBeanDefinition&lt;/font&gt;&lt;br&gt;【注解能力增强桥梁】" 作用="在基础图纸上，增加了获取&#xa;1. 类级别注解元数据（AnnotationMetadata）&#xa;2. 工厂方法级别元数据（MethodMetadata）的方法。" 设计意图="遵循开闭原则 (OCP)。早期 Spring 1.x/2.x 只有 XML 配置。进入 3.x 时代后，注解配置崛起。Spring 没有去修改老旧的 BeanDefinition 接口，而是派生出一个新接口专门处理注解的元数据，实现了平滑过渡。" id="Rnn9wGYFX2iCv91cSKAG-174">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=60;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="92" width="227" x="1854" y="1166.5" as="geometry">
              <mxRectangle height="176" width="691" x="-344" y="5095" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-175" parent="Rnn9wGYFX2iCv91cSKAG-174" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="691" y="60" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-176" parent="Rnn9wGYFX2iCv91cSKAG-174" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getMetadata() : AnnotationMetadata" vertex="1">
          <mxGeometry height="54" width="691" y="68" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-177" parent="Rnn9wGYFX2iCv91cSKAG-174" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getFactoryMethodMetadata() : MethodMetadata" vertex="1">
          <mxGeometry height="54" width="691" y="122" as="geometry" />
        </mxCell>
        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;AbstractBeanDefinition&lt;br&gt;【抽象通用存储骨架】" 作用="这是整个体系里的绝对核心体力担当。它把 BeanDefinition 接口里定义的所有属性（如 beanClass, scope, lazyInit, constructorArgumentValues, propertyValues 等）都变成了真实的私有字段，并提供了 getter/setter。" 设计意图="模板方法模式的最佳实践。无论你上面是注解进来的、XML 进来的、还是 Java Config 进来的图纸，最终描述一个 Bean 的核心属性是一致的。把通用逻辑抽取到抽象类，子类只需要关心自己特有的解析逻辑。" id="Rnn9wGYFX2iCv91cSKAG-178">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=65;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#E8D09E;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#FEF5E1;dashed=1;dashPattern=8 4;" vertex="1">
            <mxGeometry height="91" width="211" x="1338.5" y="1385.7600000000002" as="geometry">
              <mxRectangle height="258" width="510" x="-1537" y="5135" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-179" parent="Rnn9wGYFX2iCv91cSKAG-178" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="-volatile Object beanClass" vertex="1">
          <mxGeometry height="43" width="510" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-180" parent="Rnn9wGYFX2iCv91cSKAG-178" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="-String scope" vertex="1">
          <mxGeometry height="43" width="510" y="108" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-181" parent="Rnn9wGYFX2iCv91cSKAG-178" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="-boolean abstractFlag" vertex="1">
          <mxGeometry height="43" width="510" y="151" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-182" parent="Rnn9wGYFX2iCv91cSKAG-178" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="-boolean lazyInit" vertex="1">
          <mxGeometry height="43" width="510" y="194" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-183" parent="Rnn9wGYFX2iCv91cSKAG-178" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="21" width="510" y="237" as="geometry" />
        </mxCell>
        <object label="ChildBeanDefinition&lt;br&gt;⛔️ 【已被淘汰的设计】" 作用="早期 XML 时代用于配置 &lt;bean parent=&quot;xxx&quot;&gt;。它本身不能独立存在，必须依附于父 Bean。因为设计上过于割裂，目前已被 GenericBeanDefinition 取代，属于时代眼泪。" id="Rnn9wGYFX2iCv91cSKAG-184">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=52;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="74" width="221" x="1018.5" y="1644.0699999999997" as="geometry">
              <mxRectangle height="83" width="273" x="-1222" y="5100" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-185" parent="Rnn9wGYFX2iCv91cSKAG-184" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="31" width="273" y="52" as="geometry" />
        </mxCell>
        <object label="RootBeanDefinition&lt;br&gt;🔥 【运行时终态图纸】" 作用="非常核心的概念！ 当 Spring 容器要把图纸变成真正的对象前（DefaultListableBeanFactory#getBean），如果发现图纸有继承关系，会把父图纸和子图纸（比如前面提到的 Generic）合并 (Merge) 起来。合并后的最终、最完整的图纸，就是 RootBeanDefinition。" 设计意图="它是为**“实例化”**量身定制的。它不支持设置 Parent，因为它是合并后的最终态。容器后续做反射创建、依赖注入时，读取这个对象速度最快、状态最稳定。图中下方的 ClassDerivedBeanDefinition（编程式推断）和 ConfigurationClassBeanDefinition（处理 @Bean 方法）由于在运行时才确定，因此直接继承自它。" id="Rnn9wGYFX2iCv91cSKAG-186">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=52;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="76" width="226" x="1331" y="1644.0699999999997" as="geometry">
              <mxRectangle height="83" width="247" x="-798" y="5345" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-187" parent="Rnn9wGYFX2iCv91cSKAG-186" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="31" width="247" y="52" as="geometry" />
        </mxCell>
        <object label="ClassDerivedBeanDefinition&lt;br&gt;💡 【编程式函数式注册黑科技】" 作用="Spring 5 开始支持 Lambda 注册（`registerBean`）。&#xa;直接基于目标 Class 和 Supplier 构造的纯净版 Root 图纸，&#xa;极致轻量由于类已确定，无需经历合并和类名解析推断！" id="Rnn9wGYFX2iCv91cSKAG-188">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=52;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="83" width="260" x="1057.5" y="1830" as="geometry">
              <mxRectangle height="95" width="234" x="-1105" y="5572" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-189" parent="Rnn9wGYFX2iCv91cSKAG-188" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="43" width="234" y="52" as="geometry" />
        </mxCell>
        <object label="ConfigurationClassBeanDefinition&lt;br&gt;🏭 【@Bean 方法专属工厂图纸】" 作用="专为 `@Configuration` 类内部标注了 `@Bean` 的方法准备！&#xa;由配置类读取器解析方法后直接生成根类型的图纸，&#xa;并记录下 factoryMethodName 和 MethodMetadata。" id="Rnn9wGYFX2iCv91cSKAG-190">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=52;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="78" width="247" x="1492.5" y="1835" as="geometry">
              <mxRectangle height="95" width="299" x="-637" y="5590" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-191" parent="Rnn9wGYFX2iCv91cSKAG-190" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="43" width="299" y="52" as="geometry" />
        </mxCell>
        <object label="GenericBeanDefinition&lt;br&gt;🛠️ 【大一统万能标准图纸】" 作用="作用： Spring 2.5 引入。它可以作为根，也可以通过 setParentName() 指定父 Bean。如今我们在解析配置（无论是 XML 还是简单的编程式注册）时，绝大部分初始生成的都是它及其子类。它极其灵活，是配置态的“万能胶”。" id="Rnn9wGYFX2iCv91cSKAG-192">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=52;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="78" width="234" x="1650" y="1644.0699999999997" as="geometry">
              <mxRectangle height="89" width="221" x="-455" y="5096" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-193" parent="Rnn9wGYFX2iCv91cSKAG-192" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="37" width="221" y="52" as="geometry" />
        </mxCell>
        <object label="AnnotatedGenericBeanDefinition&lt;br&gt;⚙️ 【编程式配置专供】" 作用="当你通过 ApplicationContext.register(MyConfig.class) 直接编程式地注册一个配置类时，Spring 会用它来包装。它不经过扫描，直接通过反射获取注解元数据。" id="Rnn9wGYFX2iCv91cSKAG-194">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=52;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#6AAF7A;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EAF6ED;" vertex="1">
            <mxGeometry height="73" width="260" x="2234" y="1458" as="geometry">
              <mxRectangle height="89" width="225" x="143" y="5213" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-195" parent="Rnn9wGYFX2iCv91cSKAG-194" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="37" width="225" y="52" as="geometry" />
        </mxCell>
        <object label="ScannedGenericBeanDefinition&lt;br&gt;📡 【包扫描主力部队】" 作用="当你使用 @Component、@Service，并且 Spring 通过 ASM 技术进行类路径包扫描（ClassPath Scanning）时，遇到一个组件就会生成一个这个类的实例。它不仅拥有通用属性，还内部持有该类的 AnnotationMetadata（我知道自己身上标了什么注解）。" id="Rnn9wGYFX2iCv91cSKAG-196">
