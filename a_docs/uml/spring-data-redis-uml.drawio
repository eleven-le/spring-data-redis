        <mxCell id="Rnn9wGYFX2iCv91cSKAG-280" connectable="0" parent="Rnn9wGYFX2iCv91cSKAG-279" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;b&gt;&lt;span style=&quot;color: rgb(85, 85, 85); background-color: rgb(232, 232, 232);&quot;&gt;implements&lt;/span&gt;&lt;span style=&quot;color: rgb(85, 85, 85); background-color: rgb(232, 232, 232);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;实现了基石层的“贴纸”能力&lt;/font&gt;&lt;/b&gt;" vertex="1">
