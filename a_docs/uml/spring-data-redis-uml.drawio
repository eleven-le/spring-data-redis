          <mxGeometry height="309.8" width="649" x="1188" y="2703.8" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-218" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;strokeWidth=2;fillColor=#eeeeee;strokeColor=none;fontColor=#FFA530;rounded=1;shadow=0;glass=0;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;arcSize=12;fontFamily=Helvetica;fontSize=15;fontStyle=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="161.9" width="676" x="388" y="2843.1000000000004" as="geometry" />
        </mxCell>
        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;AnnotatedTypeMetadata&lt;/font&gt;&lt;br&gt;【注解元数据统一抽象】&lt;div&gt;&lt;br&gt;&lt;/div&gt;" 作用="这是所有能够“挂载注解”的元素的顶层抽象。它提供了统一的方法来检查某个元素是否标注了特定注解（如 isAnnotated(String annotationName)），以及获取注解的属性值（如 getAnnotationAttributes(...)）。" 设计用意="在 Java 中，不仅 Class 类上可以打注解，Method 方法上也可以打注解（比如 @Bean）。抽象出这个接口，就可以复用统一的注解读取逻辑，无论是读取类上的还是方法上的注解，都可以用这一个契约来处理，符合面向对象设计中的单一职责原则。" id="Rnn9wGYFX2iCv91cSKAG-219">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=65;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="91" width="273" x="784.5" y="2258" as="geometry">
              <mxRectangle height="229" width="531" x="143" y="5447" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-220" parent="Rnn9wGYFX2iCv91cSKAG-219" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="531" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-221" parent="Rnn9wGYFX2iCv91cSKAG-219" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getAnnotations() : MergedAnnotations" vertex="1">
          <mxGeometry height="52" width="531" y="73" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-222" parent="Rnn9wGYFX2iCv91cSKAG-219" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+isAnnotated(String) : boolean" vertex="1">
          <mxGeometry height="52" width="531" y="125" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-223" parent="Rnn9wGYFX2iCv91cSKAG-219" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getAnnotationAttributes(String) : Map" vertex="1">
          <mxGeometry height="52" width="531" y="177" as="geometry" />
        </mxCell>
        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;ClassMetadata&lt;/font&gt;&lt;br&gt;【类的结构画像】&lt;div&gt;&lt;br&gt;&lt;/div&gt;" 作用="纯粹用于描述一个 Java 类的骨架结构（不包含任何注解信息）。它提供获取类名、是否是接口、是否是抽象类、父类名称、实现的接口名称等能力。" 设计用意="有时候 Spring 只需要知道一个类的层级结构（比如在做类型推断或层次结构分析时），而不需要去进行复杂的注解解析。将结构信息单独抽取为一个接口，保证了操作的轻量化，避免了无谓的性能开销。" id="Rnn9wGYFX2iCv91cSKAG-224">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=65;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#A1C2EC;strokeWidth=1;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#EBF3FC;" vertex="1">
            <mxGeometry height="105" width="233" x="1396" y="2251" as="geometry">
              <mxRectangle height="265" width="425" x="1353" y="5381" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-225" parent="Rnn9wGYFX2iCv91cSKAG-224" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1">
          <mxGeometry height="8" width="425" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Rnn9wGYFX2iCv91cSKAG-226" parent="Rnn9wGYFX2iCv91cSKAG-224" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="+getClassName() : String" vertex="1">
