        <object label="&lt;span style=&quot;color: rgb(255, 165, 48); font-weight: 700; text-align: left;&quot;&gt;&lt;font&gt;第一层&lt;br&gt;基础设施接入层 (基石)&lt;/font&gt;&lt;/span&gt;" 作用="这一层体现了 Spring 高度抽象和面向接口编程的设计思想。Spring 并没有一开始就设计一个庞大的 Bean 类，而是从最基础的两个通用能力开始定义。" id="Rnn9wGYFX2iCv91cSKAG-292">
          <mxCell parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;labelBorderColor=none;textShadow=1;labelBackgroundColor=default;" vertex="1">
            <mxGeometry height="39" width="195" x="1108" y="905.5" as="geometry" />
          </mxCell>
        </object>
