        <object label="&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(51, 51, 51); font-size: 12px; text-wrap-mode: nowrap;&quot;&gt;AbstractRedisConnection&lt;/span&gt;&lt;br&gt;【抽象通用存储骨架】" 作用="这是整个体系里的绝对核心体力担当。它把 BeanDefinition 接口里定义的所有属性（如 beanClass, scope, lazyInit, constructorArgumentValues, propertyValues 等）都变成了真实的私有字段，并提供了 getter/setter。" 设计意图="模板方法模式的最佳实践。无论你上面是注解进来的、XML 进来的、还是 Java Config 进来的图纸，最终描述一个 Bean 的核心属性是一致的。把通用逻辑抽取到抽象类，子类只需要关心自己特有的解析逻辑。" id="Rnn9wGYFX2iCv91cSKAG-649">
          <mxCell collapsed="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=65;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;strokeColor=#E8D09E;strokeWidth=2;spacing=6;fontFamily=Helvetica;fontSize=13;fontColor=#37352F;fillColor=#FEF5E1;dashed=1;dashPattern=8 4;" vertex="1">
            <mxGeometry height="91" width="211" x="1371.5" y="4970" as="geometry">
              <mxRectangle height="258" width="510" x="-1537" y="5135" as="alternateBounds" />
            </mxGeometry>
          </mxCell>
        </object>
